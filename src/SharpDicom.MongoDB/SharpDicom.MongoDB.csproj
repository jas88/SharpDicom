<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SharpDicom.MongoDB</RootNamespace>

    <!-- NuGet Package -->
    <PackageId>SharpDicom.MongoDB</PackageId>
    <Description>MongoDB integration for SharpDicom DICOM toolkit. Provides BsonDocument adapter, collection helpers, index recommendations, and bulk import for DICOM metadata storage.</Description>
    <PackageTags>dicom;mongodb;bson;medical-imaging;pacs;metadata</PackageTags>
    <PackageProjectUrl>https://github.com/jas88/SharpDicom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jas88/SharpDicom.git</RepositoryUrl>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpDicom\SharpDicom.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="MongoDB.Driver" />
    <!-- Pin vulnerable transitive deps of MongoDB.Driver (GHSA-6c8g-7p36-r338, GHSA-pggp-6c3x-2xmx) -->
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="Snappier" />
  </ItemGroup>
</Project>
