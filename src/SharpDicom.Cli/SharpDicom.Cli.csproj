<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Tomlyn/Spectre.Console are not fully trim-annotated -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpDicom.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpDicom\SharpDicom.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="PublishAotCross" />
    <PackageReference Include="PublishAotCrossXWin" />
  </ItemGroup>
</Project>
