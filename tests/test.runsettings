<RunSettings>
  <NUnit>
    <!-- Stop on first failure for faster feedback -->
    <StopOnError>false</StopOnError>
  </NUnit>
  <!-- Note: DefaultTimeout and TestSessionTimeout removed - not supported by Microsoft.Testing.Platform -->
  <!-- Timeouts are controlled by CI workflow timeout-minutes and per-test [Timeout] attributes -->
</RunSettings>
